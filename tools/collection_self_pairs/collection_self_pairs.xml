<tool id="collection_self_pairs" name="Collection self-pairs" version="1.0+galaxy0" profile="23.0">
    <description>one {id}_{id} per element identifier (self-cross diagonal to exclude)</description>
    <requirements>
        <requirement type="package" version="3.12">python</requirement>
    </requirements>
    <required_files>
        <include path="self_pairs.py"/>
    </required_files>
    <command detect_errors="exit_code"><![CDATA[
python '$__tool_directory__/self_pairs.py'
    --ids '#echo " ".join([str($el.element_identifier) for $el in $input])#'
    --out '$output'
    ]]></command>
    <inputs>
        <param name="input" type="data_collection" label="List collection" help="The {id}_{id} self-pairs are derived from this collection's element identifiers." collection_type="list"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="${tool.name} on ${on_string}: self-pairs"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input">
                <collection type="list">
                    <element name="spA" value="dummy.txt" ftype="txt"/>
                    <element name="spB" value="dummy.txt" ftype="txt"/>
                    <element name="spC" value="dummy.txt" ftype="txt"/>
                </collection>
            </param>
            <output name="output" ftype="txt">
                <assert_contents>
                    <has_n_lines n="3"/>
                    <has_line line="spA_spA"/>
                    <has_line line="spB_spB"/>
                    <has_line line="spC_spC"/>
                </assert_contents>
            </output>
        </test>
    </tests>
    <help><![CDATA[
Emits one ``{id}_{id}`` line per element identifier of the input list collection — the
self-cross diagonal to remove with ``__FILTER_FROM_FILE__`` (remove_if_present). Run it on
the genome collection for panel self-pairs, or on the anchor collection for anchor self-pairs.
    ]]></help>
    <citations>
        <citation type="doi">10.1093/nar/gkae410</citation>
    </citations>
</tool>
